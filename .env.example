# Copie para .env (ignorado pelo Git) e ajuste. Nunca versione valores reais.
# SA_PASSWORD: minimo de 8 caracteres com 3 de 4 categorias (maiuscula, minuscula, numero, simbolo).
#              Evite ';' e '$' (quebram a connection string / interpolacao do Compose).
SA_PASSWORD=FinanceApi_Local_2026_Strong_Password
# JWT_SECRET: minimo de 32 caracteres (validado na inicializacao da API). O valor de exemplo abaixo e REJEITADO
#             pela API (placeholder publico): gere um proprio, ex.: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
